PORT=4000
# Postgres connection string (Render internal DB URL, local Postgres, Neon, etc.)
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
# Optional alternative to DATABASE_URL
# POSTGRES_URL=
# Optional path to a file whose first line is the DB URL
# DATABASE_URL_FILE=

# Buffalo currently uses the Ria-branded placeholder provider for checkout and payout.
PAYMENT_PROVIDER=ria
# Keep false for now: Ria code stays implemented in the backend but is not used by the
# normal transfer flow until you explicitly activate it.
RIA_ACTIVE=false
# Optional: force which rail handles *new* transfers (see src/transfer/rail/registry.ts)
# THAILAND_TRANSFER_RAIL=ria_e2e

# Public URL of this API (for Ria return/notification links). On Render, RENDER_EXTERNAL_URL is often set.
# PUBLIC_API_URL=
# Public URL of the web app (redirect after pay)
# PUBLIC_WEB_APP_URL=http://localhost:5173

# Official Ria staging/base URL, no trailing slash
RIA_BASE_URL=
RIA_API_KEY=
RIA_API_SECRET=
# Required by Ria web services on every call
RIA_CLIENT_IP_ADDRESS=127.0.0.1
# Set false when credentials above are configured (or omit; auto-mock if keys empty)
RIA_USE_MOCK=true
# Optional dormant rail scaffolding for a future direct transfer rollout
RIA_THAILAND_PAYER_ID=
RIA_COLLECTION_MERCHANT_ID=
RIA_COLLECTION_PAGE_ID=

# Your platform fee: percent of the "send" amount. Example: 4 = 4% → $4 fee on $100 send, card charged $104.
# Checkout charges totalCharged = amountSend + platformFee, while the payout side sends amountSend only.
# The difference is your margin on the collection side.
PLATFORM_FEE_PERCENT=4
